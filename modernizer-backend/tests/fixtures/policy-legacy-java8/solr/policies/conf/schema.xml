<?xml version="1.0" encoding="UTF-8" ?>
<schema name="policies" version="1.5">
  <fields>
    <field name="_version_" type="long" indexed="true" stored="true"/>
    <field name="id" type="string" indexed="true" stored="true" required="true"/>
    <field name="policy_number" type="string" indexed="true" stored="true"/>
    <field name="holder_name" type="text_general" indexed="true" stored="true"/>
    <field name="premium" type="tdouble" indexed="true" stored="true"/>
    <field name="status" type="string" indexed="true" stored="true"/>
  </fields>
  <uniqueKey>id</uniqueKey>
  <types>
    <fieldType name="string" class="solr.StrField" sortMissingLast="true"/>
    <fieldType name="long" class="solr.TrieLongField" precisionStep="0"/>
    <fieldType name="tdouble" class="solr.TrieDoubleField" precisionStep="8"/>
    <fieldType name="text_general" class="solr.TextField">
      <analyzer><tokenizer class="solr.StandardTokenizerFactory"/><filter class="solr.LowerCaseFilterFactory"/></analyzer>
    </fieldType>
  </types>
</schema>
