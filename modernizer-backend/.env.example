# ── LLM access: use ONE of the two options below ─────────────────────────────
# The backend prints which one it is using at startup, and /health reports it.

# Option A — Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Option B — Vertex AI on your Google Cloud project. Comment out GEMINI_API_KEY
# above (if both are set, Vertex AI wins and the key is ignored).
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id       # or GCP_PROJECT_ID
# GOOGLE_CLOUD_LOCATION=us-central1              # or GCP_LOCATION; `global` also works
#
# Credentials for Option B, one of:
#   - run `gcloud auth application-default login` once (nothing to set here), or
#   - point at a service-account key file:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
#   - or nothing at all on GCE / GKE / Cloud Run, where the metadata server supplies them.
# The account needs the "Vertex AI User" role on the project.

# Optional. Defaults to gemini-2.5-flash when unset. Same model name on both options.
GEMINI_MODEL=gemini-2.5-flash

# Optional — retries for model calls rejected with 429 RESOURCE_EXHAUSTED (quota /
# rate limit), 408 or 5xx. Exponential backoff with jitter; the defaults wait
# ~2, 4, 8, 16, 32, 60, 60 s (about three minutes) before giving up on a call.
# LLM_RETRY_ATTEMPTS=8
# LLM_RETRY_INITIAL_DELAY=2
# LLM_RETRY_MAX_DELAY=60

# Optional — Java 8 -> 11 analysis before planning: `inventory` (default) scans every
# file deterministically and uses no model tokens; `agent` runs the reverse-engineering
# agents for a business-level BRD (costs tokens in proportion to what they read).
# JAVA11_ANALYSIS=inventory

# Optional — the same choice for Java 8 -> 25, Solr 4 -> 9, Oracle 19c -> 23ai and
# TIBCO EMS -> Pub/Sub. JSP -> React + BFF and stack discovery always use their agents.
# MIGRATION_ANALYSIS=inventory
# INVENTORY_MAX_ROWS=400

# Optional — Java 8 -> 11 large repositories (JAVA11_ANALYSIS=agent only): files per reverse-engineering unit
# (each analysed in its own run; 0 = one run over the whole repository), and the
# size limits for the findings those runs produce.
# RE_UNIT_MAX_FILES=300
# RE_FINDINGS_MAX_CHARS=20000
# RE_SYNTHESIS_MAX_CHARS=400000

# Optional — stack discovery on large repositories.
# Agent runs in flight at once (units, rule batches); the LLM pacer still applies.
# RE_CONCURRENCY=4
# A stack with more of its own source files than this is documented in units of
# DISCOVERY_UNIT_MAX_FILES files, each read in full by its own run.
# DISCOVERY_CHUNK_MIN_FILES=150
# DISCOVERY_UNIT_MAX_FILES=40
# Business-rules extraction: every rule candidate in the confirmed stacks' code is
# parsed and classified (catalog + coverage report + CSV ledger). `off` skips it.
# RULES_EXTRACTION=on
# RULES_BATCH_MAX_CANDIDATES=40
# RULES_BATCH_MAX_CHARS=60000
# RULES_CANDIDATE_MAX_LINES=250
# RULES_CATALOG_MAX_IN_DOCUMENT=2000

# Optional — SQLite/Postgres URL for persistent sessions. Omit for in-memory.
# DATABASE_URL=sqlite:///./modernizer.db

# Optional — validate -> fix cycles per build loop (per stage, for the
# java-8-to-25 incremental strategy). Defaults to 3.
# BUILD_LOOP_MAX_ITERATIONS=3

# Optional — validate -> fix cycles for the test-validation loop. Defaults to 3.
# TEST_RETRY_ATTEMPTS=3

# Optional — set to 0 to stop validator/fixer agents appending learned error
# patterns to their own SKILL.md. Use for read-only or shared checkouts.
# MODERNIZER_SKILL_LEARNING=1

# Java 8 -> 11: the machine that runs the backend builds and tests the result.
# Before planning, a preflight checks that Maven runs on a JDK 11 and builds the
# uploaded code on it (its errors become the plan); a broken environment stops
# the run with what to fix. Windows example: C:\\Program Files\\Eclipse Adoptium\\jdk-11.0.22.7-hotspot
# MIGRATION_JAVA_HOME=/usr/lib/jvm/java-11-openjdk-amd64
# Optional JDK 8: runs the uploaded tests once, so failures that predate the migration are not "fixed".
# BASELINE_JAVA_HOME=/usr/lib/jvm/java-8-openjdk-amd64
# Optional settings.xml with your repository mirrors / credentials (what your normal builds use).
# MAVEN_SETTINGS=/home/me/.m2/settings.xml
# PREFLIGHT=on
# VALIDATE_RUN_TESTS=true
# VALIDATE_TIMEOUT_SECONDS=3600

# Approved versions: the exact versions the Java 8 -> 11 migration may use for listed
# artifacts (the ones your internal Nexus serves). Edit approved-versions.txt.
# APPROVED_VERSIONS_FILE=./approved-versions.txt
# true = nothing may be introduced unless it is on the list
# APPROVED_VERSIONS_STRICT=false

# ── Avoiding 429s ────────────────────────────────────────────────────────────
# A model per agent role (unset = GEMINI_MODEL). Suggested on Vertex AI:
# MODEL_PLAN=gemini-2.5-pro
# MODEL_FIX=gemini-2.5-pro
# MODEL_REVIEW=gemini-2.5-pro
# MODEL_CODE=gemini-2.5-pro
# MODEL_CHECK=gemini-2.5-flash
# MODEL_REPORT=gemini-2.5-flash
# MODEL_ANALYSE=gemini-2.5-flash
# When a call is still rate-limited after LLM_FALLBACK_AFTER_ATTEMPTS, send it to this model.
# MODEL_FALLBACK=gemini-2.5-flash
# LLM_FALLBACK_AFTER_ATTEMPTS=3
# Pace calls to ~80% of your per-minute quota (Console -> IAM & Admin -> Quotas).
# LLM_MAX_TPM=0
# LLM_MAX_RPM=0
# LLM_LIMITS=gemini-2.5-pro=tpm:400000,rpm:50;gemini-2.5-flash=tpm:1500000,rpm:200
# Mask old tool output inside an agent's run (0 = off).
# CONTEXT_PROTECT_TOKENS=12000
# CONTEXT_MIN_PRUNABLE_TOKENS=5000
