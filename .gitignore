# Python backend
# `.venv*`, not just `.venv/`: a venv being replaced gets moved aside first
# (see the README's note on copied venvs), and that backup must not be committed.
modernizer-backend/.venv*/
modernizer-backend/.pytest_cache/
modernizer-backend/__pycache__/
modernizer-backend/**/__pycache__/
modernizer-backend/*.pyc
modernizer-backend/*.db
modernizer-backend/modernizer.db

# Environment secrets — NEVER commit these
modernizer-backend/.env

# Frontend
modernizer-app/node_modules/
modernizer-app/dist/

# macOS
.DS_Store

# Advisory lock files created at runtime by the skill-learning callback
*.SKILL.md.lock
SKILL.md.lock
agents/skills/*/SKILL.md.lock
